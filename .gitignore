# Python-generated local caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Local account profiles and active-profile link.
profiles/*
!profiles/.keep
!profiles/default/
profiles/default/**
!profiles/default/.keep

# Shared Codex conversations, memories, and SQLite state.
shared/codex/**
!shared/codex/.keep

# Credential-bearing backups.
backups/*
!backups/.keep

# Runtime publication allowlist: only the current release.
# Update this version deliberately when publishing a new release.
/runtime/codex/versions/**
!/runtime/codex/versions/0.167.2-local-runtime-shared-fork.parts/
!/runtime/codex/versions/0.167.2-local-runtime-shared-fork.parts/part-[0-9][0-9]
!/runtime/codex/versions/0.167.2-local-runtime-shared-fork.parts/MANIFEST.sha256
!/runtime/codex/versions/0.167.2-local-runtime-shared-fork.parts/runtime.tar.gz.sha256

# Local upgrade reports, downloads and scratch files are not release contents.
/UPGRADE_*.md
/*.log
/*.log.*
/*.tmp
/*.tmp.*
/*.bak
/*.bak.*
/*.tar
/*.tar.gz
/*.tar.xz
/*.zip
/*.whl
/*.download
/*.partial

# Workspace-local temporary, build and tool-cache data.
.work/
