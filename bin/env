#!/bin/sh
# Add this bundle's binaries to PATH if they are not present yet.
if [ -n "${BASH_VERSION:-}" ]; then
    codex_bundle_source=${BASH_SOURCE[0]}
elif [ -n "${ZSH_VERSION:-}" ]; then
    eval 'codex_bundle_source=${(%):-%x}'
else
    printf '%s\n' 'Source bin/env from Bash or Zsh; use bin/env.fish for Fish.' >&2
    return 1 2>/dev/null || exit 1
fi
codex_bundle_bin=$(CDPATH= cd -- "$(dirname -- "$codex_bundle_source")" && pwd -P)
# Affix colons on either side of PATH to simplify matching.
case ":${PATH}:" in
    *:"${codex_bundle_bin}":*)
        ;;
    *)
        # Prepend so the bundled binaries override system-installed versions.
        export PATH="${codex_bundle_bin}:$PATH"
        ;;
esac
unset codex_bundle_bin codex_bundle_source
